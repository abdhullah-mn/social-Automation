PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/social-automation
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
NODE_ENV=development
COOKIE_SAME_SITE=lax
# Your existing ZERNIO_API variable is also accepted; the key stays server-side.
ZERNIO_API_KEY=
# Set the same random secret on the webhook endpoint in Zernio's dashboard.
ZERNIO_WEBHOOK_SECRET=
